# Copy this file to .env.local, or run: npm run setup
# With Kinde left empty, Notch runs on your machine with a local account and a built-in stand-in for the provider's meter.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Convex. `npx convex dev` fills in NEXT_PUBLIC_CONVEX_URL for you.
NEXT_PUBLIC_CONVEX_URL=
# A long random string. Set the same value in .env.local and on the Convex deployment (npm run setup does both).
NOTCH_SERVER_KEY=

# Kinde: sign-in for the website and the CLI
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/app
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000
# The client id of a "Device and IoT" application in Kinde. The CLI signs in with it.
KINDE_DEVICE_CLIENT_ID=

# Set on the Convex deployment, not here, to report to Kinde instead of the built-in meter:
#   npx convex env set METER_DRIVER kinde
#   npx convex env set KINDE_DOMAIN https://yourdomain.kinde.com
#   npx convex env set KINDE_M2M_CLIENT_ID ...
#   npx convex env set KINDE_M2M_CLIENT_SECRET ...
# The machine-to-machine app needs the create:meter_usage scope.
# Set METER_DRIVER=kinde here too, so the dashboard hides the break-it-on-purpose switches.
METER_DRIVER=
